# Copia este archivo como .env (git-ignorado) y llena los valores.
# Las variables reales del entorno tienen prioridad sobre este archivo.

# API de CheckID (https://www.checkid.mx) — módulo modules/checkid.
# Cada consulta se cobra, así que esta clave no debe salir del servidor.
CHECKID_API_KEY=

# Segundos de espera antes de abortar una consulta a CheckID.
# La API consulta SAT, RENAPO e IMSS en vivo: pedir las seis secciones a la vez
# puede pasarse de un minuto, así que un valor bajo corta consultas que iban bien.
CHECKID_TIMEOUT=90
