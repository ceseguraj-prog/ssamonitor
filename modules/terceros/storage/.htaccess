# Los paquetes se sirven solo por ajax/descargar.php, que valida sesión,
# permiso de módulo y que el token lo haya emitido esa misma sesión.
# Nada de esta carpeta debe alcanzarse por URL directa.

# Apache 2.4
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
